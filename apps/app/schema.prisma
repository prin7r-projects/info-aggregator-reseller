datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  email                     String?         @unique
  username                  String?         @unique
  isAdmin                   Boolean         @default(false)

  paymentProcessorUserId    String?         @unique
  lemonSqueezyCustomerPortalUrl String?     // You can delete this if you're not using Lemon Squeezy as your payments processor.
  subscriptionStatus        String?         // 'active', 'cancel_at_period_end', 'past_due', 'deleted'
  subscriptionPlan          String?         // 'hobby', 'pro'
  datePaid                  DateTime?
  credits                   Int             @default(3)

  gptResponses              GptResponse[]
  contactFormMessages       ContactFormMessage[]
  tasks                     Task[]
  files                     File[]
}

model GptResponse {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  content                   String
}

model Task {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  description               String
  time                      String          @default("1")
  isDone                    Boolean         @default(false)
}

model File {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  name                      String
  type                      String
  s3Key                     String
}

model DailyStats {
  id                               Int             @id @default(autoincrement())
  date                             DateTime        @default(now()) @unique

  totalViews                       Int             @default(0)
  prevDayViewsChangePercent        String          @default("0")
  userCount                        Int             @default(0)
  paidUserCount                    Int             @default(0)
  userDelta                        Int             @default(0)
  paidUserDelta                    Int             @default(0)
  totalRevenue                     Float           @default(0)
  totalProfit                      Float           @default(0)

  sources                          PageViewSource[]
}

model PageViewSource {
  @@id([date, name])
  name                     String
  date                     DateTime        @default(now())

  dailyStats               DailyStats?     @relation(fields: [dailyStatsId], references: [id])
  dailyStatsId             Int?

  visitors                 Int
}

model Logs {
  id                       Int             @id @default(autoincrement())
  createdAt                DateTime        @default(now())

  message                  String
  level                    String
}

model ContactFormMessage {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  content                   String
  isRead                    Boolean         @default(false)
  repliedAt                 DateTime?
}

// ============================================================================
// Annotedly Domain Schema (Phase 1.1 - PRI-2454)
// Based on docs/12 §2.2 Technical Specification
// ============================================================================

model Subscriber {
  id                        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                     String          @unique
  firmName                  String?         @map("firm_name")
  createdAt                 DateTime        @default(now()) @map("created_at")

  subscriptions             Subscription[]

  @@map("subscribers")
}

model Subscription {
  id                        String          @id // 'annotedly_single_<ts>_<rand>'
  subscriberId              String          @map("subscriber_id") @db.Uuid
  tier                      String          // 'single'|'bundle'|'reseller'
  vertical                  String?         // for 'single' tier
  resellerConfigId          String?         @map("reseller_config_id") @db.Uuid
  status                    String          @default("pending") // 'pending'|'active'|'cancelled'|'paused'
  invoiceId                 String?         @map("invoice_id")
  validUntil                DateTime?       @map("valid_until")
  feedToken                 String?         @unique @map("feed_token")
  trackedLogUntil           DateTime?       @map("tracked_log_until") // 3 weeks from start
  createdAt                 DateTime        @default(now()) @map("created_at")

  subscriber                Subscriber      @relation(fields: [subscriberId], references: [id])
  resellerConfig            ResellerConfig? @relation(fields: [resellerConfigId], references: [id])

  @@index([subscriberId, status], map: "subscriptions_subscriber_id_status_idx")
  @@map("subscriptions")
}

model Issue {
  id                        String          @id // 'An-2026-W19-fintech'
  vertical                  String
  weekStart                 DateTime        @map("week_start") @db.Date
  publishedAt               DateTime?       @map("published_at")
  inputCount                Int?            @map("input_count")
  outputCount               Int?            @map("output_count")
  dedupeRatio               Decimal?        @map("dedupe_ratio") @db.Decimal(6, 2)

  dossierItems              DossierItem[]

  @@map("issues")
}

model Source {
  id                        String          @id // 'src-fintech-fed-2026-04-12'
  url                       String
  retrievedAt               DateTime?       @map("retrieved_at")
  sha256                    String
  contentType               String?         @map("content_type")
  isLeak                    Boolean         @default(false) @map("is_leak")
  leakProvenance            Json?           @map("leak_provenance")

  dossierItems              DossierItem[]

  @@map("sources")
}

model DossierItem {
  id                        String          @id // 'An-2026-W19-§14'
  issueId                   String          @map("issue_id")
  sourceId                  String          @map("source_id")
  paragraphMarkdown         String          @map("paragraph_markdown")
  footnoteRefs              Json            @default("[]") @map("footnote_refs")

  issue                     Issue           @relation(fields: [issueId], references: [id])
  source                    Source          @relation(fields: [sourceId], references: [id])

  @@index([issueId], map: "dossier_items_issue_id_idx")
  @@map("dossier_items")
}

model ResellerConfig {
  id                        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resellerName              String          @map("reseller_name")
  masthead                  String
  accentHex                 String?         @map("accent_hex")
  footerLine                String?         @map("footer_line")
  deliveryUrl               String?         @map("delivery_url")
  deliveryLagMin            Int             @default(0) @map("delivery_lag_min")
  customDomain              String?         @map("custom_domain")
  logoSvg                   String?         @map("logo_svg")
  createdAt                 DateTime        @default(now()) @map("created_at")

  subscriptions             Subscription[]

  @@map("reseller_configs")
}
