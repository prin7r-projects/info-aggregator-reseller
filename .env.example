# Public app URL — used in NOWPayments redirect + webhook callback URLs.
NEXT_PUBLIC_APP_URL=https://info-aggregator-reseller.prin7r.com

# NOWPayments hosted invoice + IPN secret. Source: shared payments credentials in keys file.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# Reown / WalletConnect Cloud project ID (reserved — wired in next polish pass).
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Plisio direct stablecoin invoices (reserved — backup rail per playbook §C).
PLISIO_API_KEY=

# Postgres (Phase 0a). Replace placeholders in real .env.
POSTGRES_USER=annotedly
POSTGRES_PASSWORD=changeme-postgres
POSTGRES_DB=annotedly

# MinIO (Phase 0a). Replace placeholders in real .env. Min 8 chars on password.
MINIO_ROOT_USER=annotedly
MINIO_ROOT_PASSWORD=changeme-minio
